{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/run-with-flags.sh\" guard-bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard-bash.sh\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/aegis-approval-gate/check.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/run-with-flags.sh\" guard-write \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard-write.sh\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/run-with-flags.sh\" guard-ask-user \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard-ask-user.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/run-with-flags.sh\" post-tool-use \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-tool-use.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/run-with-flags.sh\" post-edit-accumulate \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-edit-accumulate.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/tools/aegis-brain-graph/hook.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/linear-sync-on-kanban.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/research-probe-on-write.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/tools/aegis-token-profile.sh\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/aegis-live-tail/emit.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/aegis-activity-logger/log.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/run-with-flags.sh\" on-stop \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/on-stop.sh\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/aegis-run-logger/archive.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session-start.sh\""
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/aegis-resume/session-start.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/aegis-brain-graph/staleness.mjs\""
          }
        ]
      }
    ]
  }
}