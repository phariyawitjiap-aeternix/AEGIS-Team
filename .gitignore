# AEGIS Runtime Output (session artifacts — research, deployments, qa, etc.)
# Approved specs are tracked; everything else is gitignored (S2-06).
_aegis-output/*
!_aegis-output/specs/
!_aegis-output/.gitignore

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Dependencies
node_modules/
__pycache__/
*.pyc
venv/
.venv/

# Logs (all logs are runtime noise — ignore everything)
*.log

# AEGIS v9 migration backup (POC -- do not commit safety net)
.aegis-backup/
.claude/settings.json.v8-backup

# Claude Code worktrees (Sprint v9-05 isolation -- transient; merged via aegis-merge-worktree.sh)
.claude/worktrees/

# ADR-004 Phase 2: maintainer-mode grant state (transient one-shot consume markers)
.aegis/brain/state/

# Next.js build
dashboard/.next/
dashboard/node_modules/

